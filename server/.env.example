# Copy this file to .env (in the server/ folder) and fill in your own values.
# .env is ignored by Git, so your password is never committed.

# PostgreSQL connection used by the server and by npm run db:init / db:seed / db:reset.
# Format: postgres://<user>:<password>@<host>:<port>/<database>
# Special characters in the password must be URL-encoded (for example @ -> %40, # -> %23).
DATABASE_URL=postgres://studyloft:change-me@localhost:5432/studyloft
